#!/bin/sh
# Sourced by bin/converger before every command. Sets up Erlang distribution
# when clustering is enabled (see docs/operations/clustering.md):
#
#   CLUSTER_STRATEGY      none (default), kubernetes_dns, dns, gossip, epmd
#   RELEASE_COOKIE        shared secret of the cluster; REQUIRED when
#                         clustering (the cookie baked into the image is the
#                         same for everyone who has the image)
#   RELEASE_DISTRIBUTION  defaults to "name" (long names) when clustering
#   RELEASE_NODE          defaults to <CLUSTER_NODE_BASENAME>@<IP>, the IP
#                         taken from POD_IP, FLY_PRIVATE_IP or `hostname -i`
#   CLUSTER_DIST_PORT     optional fixed Erlang distribution port of the
#                         server (for firewalls and NetworkPolicies)
#
# Every value that is already set in the environment wins.

clustering=false
case "${CLUSTER_STRATEGY:-}" in
  "") [ -n "${DNS_CLUSTER_QUERY:-}" ] && clustering=true ;;
  none) ;;
  *) clustering=true ;;
esac

if [ "$clustering" = "true" ]; then
  case "${RELEASE_COMMAND:-}" in
    start|start_iex|daemon|daemon_iex)
      if [ -z "${RELEASE_COOKIE:-}" ]; then
        echo "ERROR: clustering is enabled (CLUSTER_STRATEGY=${CLUSTER_STRATEGY:-dns}) but RELEASE_COOKIE is not set." >&2
        echo "Set RELEASE_COOKIE to the same random secret on every node, e.g. openssl rand -base64 48." >&2
        exit 1
      fi
      ;;
  esac

  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"

  if [ -z "${RELEASE_NODE:-}" ]; then
    node_ip="${POD_IP:-${FLY_PRIVATE_IP:-}}"
    if [ -z "$node_ip" ]; then
      node_ip="$(hostname -i 2>/dev/null | awk '{print $1}')"
    fi
    export RELEASE_NODE="${CLUSTER_NODE_BASENAME:-<%= @release.name %>}@${node_ip}"

    # IPv6 node addresses (Fly.io 6PN) need IPv6 distribution.
    case "$node_ip" in
      *:*) export ERL_AFLAGS="-proto_dist inet6_tcp ${ERL_AFLAGS:-}" ;;
    esac
  fi

  # A fixed distribution port for the server only: `rpc` and `remote` start
  # a second node in the same pod, which must not bind the same port.
  if [ -n "${CLUSTER_DIST_PORT:-}" ]; then
    case "${RELEASE_COMMAND:-}" in
      start|start_iex|daemon|daemon_iex)
        export ERL_AFLAGS="-kernel inet_dist_listen_min ${CLUSTER_DIST_PORT} inet_dist_listen_max ${CLUSTER_DIST_PORT} ${ERL_AFLAGS:-}"
        ;;
    esac
  fi
fi
