# The Converger server, and the secret of the `websocket` channel this agent serves
# (admin panel: Channels -> your agent channel -> secret). Never commit the real value.
CONVERGER_URL=__CONVERGER_URL__
CONVERGER_CHANNEL_SECRET=
# Processes with the same group share the channel's conversations (one per conversation).
CONVERGER_AGENT_GROUP=__AGENT_GROUP__
