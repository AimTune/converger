{
  "name": "create-converger-agent",
  "version": "0.1.1",
  "description": "Scaffold a TypeScript agent for Converger: npx create-converger-agent my-agent",
  "license": "MIT",
  "author": "AimTune",
  "homepage": "https://converger.aimtune.dev/sdk/agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/converger.git",
    "directory": "packages/create-converger-agent"
  },
  "bugs": "https://github.com/AimTune/converger/issues",
  "keywords": ["converger", "agent", "create", "scaffold", "template"],
  "type": "module",
  "bin": {
    "create-converger-agent": "bin/create-converger-agent.mjs"
  },
  "exports": {
    ".": "./src/scaffold.mjs"
  },
  "files": ["bin", "src", "template", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
