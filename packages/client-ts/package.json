{
  "name": "@converger/client",
  "version": "0.1.1",
  "description": "Headless TypeScript client for Converger Protocol v1: reconnect, watermark resume, persistent outbox, token refresh, REST helpers.",
  "license": "MIT",
  "author": "AimTune",
  "homepage": "https://converger.aimtune.dev/sdk/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/converger.git",
    "directory": "packages/client-ts"
  },
  "bugs": "https://github.com/AimTune/converger/issues",
  "keywords": [
    "converger",
    "chat",
    "websocket",
    "sdk",
    "mekik"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "docs": "typedoc",
    "generate:types": "node scripts/generate-types.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
