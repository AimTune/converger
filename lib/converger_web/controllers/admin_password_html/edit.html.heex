<Layouts.auth
  flash={@flash}
  title="Change Password"
  subtitle={
    if(@forced, do: "Your account uses a temporary password. Choose a new one to continue.")
  }
>
  <div :if={@errors != []} role="alert" class="alert alert-error text-sm">
    <.icon name="hero-exclamation-circle" class="size-5" />
    <div>
      <div :for={error <- @errors}>{error}</div>
    </div>
  </div>

  <form action="/admin/password" method="post" class="space-y-1">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="_method" value="put" />

    <.input
      id="admin_password_current_password"
      type="password"
      name="admin_password[current_password]"
      value=""
      label="Current password"
      autocomplete="current-password"
      required
    />
    <.input
      id="admin_password_password"
      type="password"
      name="admin_password[password]"
      value=""
      label="New password"
      autocomplete="new-password"
      minlength={@min_length}
      required
    />
    <.input
      id="admin_password_password_confirmation"
      type="password"
      name="admin_password[password_confirmation]"
      value=""
      label="Confirm new password"
      autocomplete="new-password"
      minlength={@min_length}
      required
    />

    <button type="submit" class="btn btn-primary mt-3 w-full">Update password</button>
  </form>
</Layouts.auth>
