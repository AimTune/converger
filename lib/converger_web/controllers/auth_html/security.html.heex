<div style="max-width: 760px; margin: 20px auto;">
  <h1>Security</h1>

  <div
    :if={@error_message}
    style="background: #f8d7da; color: #721c24; padding: 10px 15px; border-radius: 4px; margin-bottom: 15px; font-size: 0.9em;"
  >
    {@error_message}
  </div>

  <div class="card" id="two-factor">
    <h3>Two-factor authentication</h3>

    <p
      :if={@required}
      style="background: #fff3e0; color: #e65100; padding: 10px 15px; border-radius: 4px;"
    >
      Your role requires two-factor authentication. Set it up to continue to the admin panel.
    </p>

    <div :if={@totp_enabled}>
      <p>
        <span class="badge badge-active">Enabled</span>
        since {format_time(@user.totp_enabled_at)}. Each login asks for a code from your authenticator app.
      </p>
      <form action={@base <> "/security/totp"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="_method" value="delete" />
        <label
          for="disable_code_or_password"
          style="display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.85em; color: #555;"
        >
          Current code or password
        </label>
        <input
          type="password"
          id="disable_code_or_password"
          name="code_or_password"
          autocomplete="off"
          required
          style="padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
        />
        <button type="submit" class="badge badge-inactive">Turn off 2FA</button>
      </form>
    </div>

    <div :if={!@totp_enabled && !@totp_pending}>
      <p>
        <span class="badge badge-inactive">Off</span>
        Protect your account with a 6-digit code from an authenticator app (TOTP).
      </p>
      <form action={@base <> "/security/totp/setup"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <button type="submit">Set up two-factor authentication</button>
      </form>
    </div>

    <div :if={@totp_pending}>
      <p>
        Add this account to your authenticator app, then enter the code it shows to turn 2FA on.
      </p>
      <p style="margin-bottom: 4px;"><strong>Secret key</strong> (manual entry, time-based):</p>
      <code
        id="totp-secret"
        style="display: block; padding: 10px; background: #f8f9fa; border-radius: 4px; word-break: break-all; font-size: 1.1em; letter-spacing: 0.1em;"
      >{@secret}</code>
      <p style="margin-bottom: 4px;"><strong>Setup URI</strong> (for apps or QR code generators):</p>
      <code
        id="totp-uri"
        style="display: block; padding: 10px; background: #f8f9fa; border-radius: 4px; word-break: break-all; font-size: 0.85em;"
      >{@otpauth_uri}</code>

      <form action={@base <> "/security/totp"} method="post" style="margin-top: 15px;">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <label
          for="confirm_code"
          style="display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.85em; color: #555;"
        >
          Code from the app
        </label>
        <input
          type="text"
          id="confirm_code"
          name="code"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="7"
          required
          style="padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
        />
        <button type="submit">Turn on 2FA</button>
      </form>
    </div>
  </div>

  <div :if={@base == "/portal"} class="card" id="password">
    <h3>Password</h3>
    <div
      :if={@password_errors != []}
      style="background: #f8d7da; color: #721c24; padding: 10px 15px; border-radius: 4px; margin-bottom: 15px; font-size: 0.9em;"
    >
      <div :for={error <- @password_errors}>{error}</div>
    </div>
    <form action={@base <> "/security/password"} method="post">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="_method" value="put" />
      <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;">
        <div>
          <label
            for="password_current_password"
            style="display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.85em; color: #555;"
          >
            Current password
          </label>
          <input
            type="password"
            id="password_current_password"
            name="password[current_password]"
            autocomplete="current-password"
            required
            style="padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
          />
        </div>
        <div>
          <label
            for="password_password"
            style="display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.85em; color: #555;"
          >
            New password
          </label>
          <input
            type="password"
            id="password_password"
            name="password[password]"
            autocomplete="new-password"
            minlength={@min_length}
            required
            style="padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
          />
        </div>
        <div>
          <label
            for="password_password_confirmation"
            style="display: block; font-weight: 600; margin-bottom: 4px; font-size: 0.85em; color: #555;"
          >
            Confirm
          </label>
          <input
            type="password"
            id="password_password_confirmation"
            name="password[password_confirmation]"
            autocomplete="new-password"
            minlength={@min_length}
            required
            style="padding: 8px; border: 1px solid #ddd; border-radius: 4px;"
          />
        </div>
        <button type="submit">Change password</button>
      </div>
      <p style="color: #666; font-size: 0.85em;">
        At least {@min_length} characters. Your other sessions are signed out.
      </p>
    </form>
  </div>

  <div :if={@base == "/admin"} class="card" id="password">
    <h3>Password</h3>
    <p><a href="/admin/password">Change your password</a>. Your other sessions are signed out.</p>
  </div>

  <div class="card" id="sessions">
    <h3>Active sessions</h3>
    <p style="color: #666; font-size: 0.9em;">
      Sessions end after {@max_age_hours} hours, or {@idle_minutes} minutes without activity.
    </p>
    <table>
      <thead>
        <tr>
          <th>Signed in</th>
          <th>Last active</th>
          <th>IP</th>
          <th>Browser</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr :for={session <- @sessions}>
          <td><small>{format_time(session.inserted_at)}</small></td>
          <td><small>{format_time(session.last_seen_at)}</small></td>
          <td>{session.ip}</td>
          <td><small>{session.user_agent}</small></td>
          <td>
            <span :if={session.id == @current_session_id} style="color: #999; font-size: 0.85em;">
              (this session)
            </span>
            <form
              :if={session.id != @current_session_id}
              action={@base <> "/security/sessions/" <> session.id}
              method="post"
              style="display: inline;"
            >
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <input type="hidden" name="_method" value="delete" />
              <button type="submit" class="badge badge-inactive">Sign out</button>
            </form>
          </td>
        </tr>
      </tbody>
    </table>

    <form action={@base <> "/security/sessions"} method="post" style="margin-top: 15px;">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="_method" value="delete" />
      <button type="submit" class="btn-logout" style="background: #dc3545;">
        Log out everywhere
      </button>
    </form>
  </div>

  <p><a href={@base}>Back</a></p>
</div>
