<Layouts.auth flash={@flash} title="Admin Login" subtitle="Sign in to Converger Admin Panel">
  <div :if={@error_message} role="alert" class="alert alert-error text-sm">
    <.icon name="hero-exclamation-circle" class="size-5" />
    <span>{@error_message}</span>
  </div>

  <form action="/admin/login" method="post" class="space-y-1">
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

    <.input
      id="admin_login_email"
      type="email"
      name="email"
      value=""
      label="Email"
      placeholder="admin@example.com"
      autocomplete="username"
      required
    />
    <.input
      id="admin_login_password"
      type="password"
      name="password"
      value=""
      label="Password"
      placeholder="Enter your password"
      autocomplete="current-password"
      required
    />

    <button type="submit" class="btn btn-primary mt-3 w-full">Sign In</button>
  </form>

  <p class="text-center text-sm">
    <.link href="/admin/password/reset" class="link link-primary">Forgot password?</.link>
  </p>
</Layouts.auth>
