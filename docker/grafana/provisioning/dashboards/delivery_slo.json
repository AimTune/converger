          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(converger_delivery_stop_duration_count{status=~\"sent|pending\",channel_type=~\"$channel_type\"}[5m])) / sum(rate(converger_delivery_stop_duration_count{channel_type=~\"$channel_type\"}[5m]))",
