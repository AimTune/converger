# The directory Mix will write compiled artifacts to.
/_build/

# Build root of the CONVERGER_PASSWORD_HASHER=pbkdf2 mode (docs/contributing.md).
/_build_pbkdf2/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
converger-*.tar


# Local secrets for docker compose (see .env.example). Never commit.
/.env
/.env.*
!/.env.example

# Admin/portal assets built by tailwind and esbuild (`mix assets.build`), and
# the digests of `mix assets.deploy`.
/priv/static/assets/
/priv/static/cache_manifest.json

# Local attachment storage (LocalStorage backend).
/priv/uploads/

# Dialyzer PLTs (cached in CI).
/priv/plts/

# Node workspace (packages/, examples/typescript/).
node_modules/
/packages/*/dist/
/packages/*/docs-api/
/packages/*/coverage/
/examples/typescript/*/dist/
