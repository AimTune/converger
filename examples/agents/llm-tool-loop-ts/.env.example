# Converger server and the secret of the `websocket` channel this agent serves.
CONVERGER_URL=http://localhost:4000
CONVERGER_CHANNEL_SECRET=
# Optional: agent group, so several processes share the channel's conversations.
CONVERGER_AGENT_GROUP=llm-tool-loop
# Anthropic API key (or `ant auth login`).
ANTHROPIC_API_KEY=
