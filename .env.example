# Copy to .env (which is gitignored) and fill in every value before running
# `docker compose up`. Compose refuses to start while a required value is
# missing. Never commit .env or reuse these placeholders.
#
# Generate fresh values with:
#   SECRET_KEY_BASE      mix phx.gen.secret   (or: openssl rand -base64 64 | tr -d '\n')
#   CLOAK_KEY            openssl rand -base64 32
#   POSTGRES_PASSWORD    openssl rand -hex 24  (hex keeps it URL-safe for DATABASE_URL)
#   GF_SECURITY_ADMIN_PASSWORD  openssl rand -hex 16

# --- Required ---
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
CLOAK_KEY=
GF_SECURITY_ADMIN_PASSWORD=

# --- Optional ---
# Public host name used in generated URLs and the default WebSocket origin check.
# PHX_HOST=localhost
# Enable behind a TLS-terminating proxy (also set TRUSTED_PROXIES).
# FORCE_SSL=false
# TRUSTED_PROXIES=
# Bearer token for GET /metrics (openssl rand -hex 32). Unset: /metrics is off.
# METRICS_TOKEN=

# --- Two-node cluster (docker-compose.cluster.yml) ---
# Erlang distribution cookie shared by all nodes (openssl rand -base64 48).
# RELEASE_COOKIE=
# Encrypts the libcluster gossip packets (openssl rand -hex 32).
# CLUSTER_GOSSIP_SECRET=
