{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converger.aimtune.dev/schemas/protocol/v1/messages/location.schema.json",
  "title": "location message data",
  "description": "A geographic point. Converger-defined: chativa has no location renderer yet and falls back to data.text.",
  "type": "object",
  "required": ["latitude", "longitude"],
  "properties": {
    "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
    "name": { "type": "string", "maxLength": 1024 },
    "address": { "type": "string", "maxLength": 1024 },
    "url": { "$ref": "../common.schema.json#/$defs/url" },
    "text": { "type": "string", "maxLength": 4096 },
    "extensions": { "$ref": "../common.schema.json#/$defs/extensions" }
  },
  "examples": [
    { "latitude": 41.0082, "longitude": 28.9784, "name": "Head office", "address": "Istanbul", "text": "Head office, Istanbul (41.0082, 28.9784)" }
  ]
}
