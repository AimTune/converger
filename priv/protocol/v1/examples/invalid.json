{
  "description": "Frames a conforming sender must never produce. The conformance suite asserts that each one fails validation, so the schemas cannot silently become permissive.",
  "frames": [
    { "direction": "s2c", "reason": "persistent message frame without seq", "frame": { "type": "text", "id": "m1", "from": "bot", "data": { "text": "hi" }, "timestamp": 1 } },
