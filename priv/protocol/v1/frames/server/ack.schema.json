{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converger.aimtune.dev/schemas/protocol/v1/frames/server/ack.schema.json",
  "title": "server -> client: ack (transient, Converger, #24)",
  "description": "The send stamped `clientId` was durably persisted as activity `id` at `seq`. Sent only to the sending connection, only for sends that carried a clientId. A retransmitted clientId gets the original ack again with duplicate = true.",
  "type": "object",
  "required": ["type", "clientId", "id", "seq", "timestamp"],
  "properties": {
    "type": { "const": "ack" },
    "clientId": { "$ref": "../../common.schema.json#/$defs/clientId" },
    "id": { "$ref": "../../common.schema.json#/$defs/id" },
    "seq": { "$ref": "../../common.schema.json#/$defs/seq" },
    "timestamp": { "$ref": "../../common.schema.json#/$defs/timestamp" },
    "duplicate": { "type": "boolean" }
  },
  "examples": [
    { "type": "ack", "clientId": "c-17", "id": "a2f7d9e4-3b1c-4d5e-8f9a-0b1c2d3e4f50", "seq": 18, "timestamp": 1750000004000 },
    { "type": "ack", "clientId": "c-17", "id": "a2f7d9e4-3b1c-4d5e-8f9a-0b1c2d3e4f50", "seq": 18, "timestamp": 1750000004000, "duplicate": true }
  ]
}
