{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converger.aimtune.dev/schemas/protocol/v1/frames/client/client_tools.schema.json",
  "title": "client -> server: client_tools (mekik/1)",
  "description": "Replace this connection's declared client tools (mekik/1 section 11.1). Forwarded to the bot channel; Converger does not interpret it.",
  "type": "object",
  "required": ["type", "tools"],
  "properties": {
    "type": { "const": "client_tools" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "parameters": { "type": "object" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "mode": { "enum": ["call", "notify"] }
        }
      }
    }
  },
  "examples": [{ "type": "client_tools", "tools": [{ "name": "pick_date", "description": "Open a date picker", "parameters": { "type": "object" } }] }, { "type": "client_tools", "tools": [] }]
}
